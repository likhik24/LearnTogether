# Copy to deploy/.env.production. Never commit the real file.
POSTGRES_PASSWORD=generate-a-long-alphanumeric-secret
JWT_SECRET=generate-at-least-32-random-bytes
INTERNAL_SERVICE_SECRET=generate-a-separate-internal-service-secret
ADMIN_EMAIL=admin@learnandbuild.org
ADMIN_PASSWORD=generate-a-long-random-password
ADMIN_NAME=Administrator
JWT_EXPIRES_IN=15m
AUTH_EMAIL_FROM=no-reply@learnandbuild.org

# MUST stay false in production. The schema is created and evolved only by the
# reviewed migrations in deploy/migrations (applied by the one-shot `migrate`
# service). TypeORM `synchronize` can silently alter or drop columns to match
# entity code, which risks data loss — never enable it against real data.
DB_SYNCHRONIZE=false
# Production discovery must contain provider/admin-approved inventory only.
SEED_DEMO_CLASSES=false

# Host directory where the Postgres data files live. Using a bind mount (rather
# than an anonymous/named volume) keeps the database on a known, backup-friendly
# path that survives container removal and even `docker compose down -v`.
# Create it once with: mkdir -p /opt/learn-and-build/postgres
POSTGRES_DATA_DIR=/opt/learn-and-build/postgres

DOCUMENTS_BUCKET=providers-profiles
AWS_REGION=ap-southeast-2
UPLOAD_URL_TTL=900

# Public ingress: the web container binds to this host address:3100. Leave as
# loopback so an external reverse proxy (nginx/Caddy/ALB) terminates TLS and
# forwards to it; set to 0.0.0.0 to publish it directly on the host.
WEB_BIND=127.0.0.1

# Optional OIDC providers.
OIDC_SUCCESS_REDIRECT=https://learnandbuild.org/profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AWS_COGNITO_ISSUER=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_CLIENT_SECRET=

# Razorpay: use test keys first, then replace with live-mode keys after verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=generate-a-separate-32-byte-random-secret
