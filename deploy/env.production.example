# Copy to deploy/.env.production. Never commit the real file.
POSTGRES_PASSWORD=generate-a-long-alphanumeric-secret
JWT_SECRET=generate-at-least-32-random-bytes
ADMIN_EMAIL=admin@learnandbuild.org
ADMIN_PASSWORD=generate-a-long-random-password
ADMIN_NAME=Administrator
JWT_EXPIRES_IN=15m
AUTH_EMAIL_FROM=no-reply@learnandbuild.org

# Set true only for the first boot of a new, empty database. After all three
# database-backed services become healthy, change to false and restart them.
DB_SYNCHRONIZE=true
# Production discovery must contain provider/admin-approved inventory only.
SEED_DEMO_CLASSES=false

DOCUMENTS_BUCKET=providers-profiles
AWS_REGION=ap-southeast-2
UPLOAD_URL_TTL=900

# Absolute host path to the locally managed Tunnel credentials JSON. Store the
# JSON outside the repository with mode 0600.
CLOUDFLARE_CREDENTIALS_PATH=/opt/learn-and-build/cloudflared/credentials.json

# Optional OIDC providers.
OIDC_SUCCESS_REDIRECT=https://learnandbuild.org/profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AWS_COGNITO_ISSUER=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_CLIENT_SECRET=
