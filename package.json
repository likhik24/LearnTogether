{
  "name": "learn-and-build",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "dev": "turbo run dev",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@learn-and-build/config": "workspace:*",
    "@playwright/test": "1.62.1",
    "eslint": "^9.17.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
