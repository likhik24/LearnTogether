# Shared local-dev environment variables. Copy to .env and adjust as needed.

# --- Auth service ---
# Postgres connection (matches docker-compose defaults)
DATABASE_URL=postgres://learnbuild:learnbuild@localhost:5432/learnbuild
# Secret used to sign JWTs. MUST be set to a strong random value in production.
JWT_SECRET=dev-insecure-secret
JWT_EXPIRES_IN=1h
# Optional initial admin, seeded on first boot if not already present.
ADMIN_EMAIL=admin@learnbuild.local
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Administrator

# --- OIDC (Google + AWS Cognito) ---
# Base URL of the auth service (used to build OIDC redirect URIs).
OIDC_REDIRECT_BASE=http://localhost:3001
# Where the browser lands after a successful OIDC login (receives #access_token).
OIDC_SUCCESS_REDIRECT=http://localhost:3100/admin
# Google: create OAuth credentials and set the redirect URI to
#   ${OIDC_REDIRECT_BASE}/auth/oidc/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_ISSUER defaults to https://accounts.google.com
# AWS Cognito: issuer is https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# Redirect URI: ${OIDC_REDIRECT_BASE}/auth/oidc/aws/callback
AWS_COGNITO_ISSUER=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_CLIENT_SECRET=

# --- Admin console (apps/web) ---
# Base URL the browser uses to reach the auth service.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3001
NEXT_PUBLIC_SCHEDULING_API_URL=http://localhost:3004
NEXT_PUBLIC_SEARCH_API_URL=http://localhost:3003
# Optional. Without it, the map uses OpenFreeMap's public MapLibre style.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Auth -> scheduling reservation integration.
SCHEDULING_API_URL=http://localhost:3004

# --- Provider service (the `teacher` container/service) ---
# S3 bucket for provider document uploads.
DOCUMENTS_BUCKET=learnbuild-documents
AWS_REGION=us-east-1
# AWS credentials are read by the provider (teacher) container for real S3 uploads.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Presigned upload URL lifetime (seconds).
UPLOAD_URL_TTL=900
# For local S3 testing against MinIO/LocalStack, set an endpoint (path-style).
# S3_ENDPOINT=http://localhost:9000

# --- Search service ---
OPENSEARCH_URL=http://localhost:9200
# Async re-index consumer (EventBridge -> SQS). Leave unset to disable locally.
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account>/learnbuild-reindex
