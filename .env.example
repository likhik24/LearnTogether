# Shared local-dev environment variables. Copy to .env and adjust as needed.

# --- Auth service ---
# Postgres connection (matches docker-compose defaults)
DATABASE_URL=postgres://learnbuild:learnbuild@localhost:5432/learnbuild
# Secret used to sign JWTs. MUST be set to a strong random value in production.
JWT_SECRET=dev-insecure-secret
JWT_EXPIRES_IN=1h
# Optional initial admin, seeded on first boot if not already present.
ADMIN_EMAIL=admin@learnbuild.local
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Administrator

# --- Admin console (apps/web) ---
# Base URL the browser uses to reach the auth service.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3001

# --- Teacher service ---
# S3 bucket for teacher document uploads.
DOCUMENTS_BUCKET=learnbuild-documents
AWS_REGION=us-east-1
# Presigned upload URL lifetime (seconds).
UPLOAD_URL_TTL=900
# For local S3 testing against MinIO/LocalStack, set an endpoint (path-style).
# S3_ENDPOINT=http://localhost:9000
