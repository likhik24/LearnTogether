FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS build
ARG NEXT_PUBLIC_AUTH_API_URL=/api/auth
ARG NEXT_PUBLIC_TEACHER_API_URL=/api/teacher
ARG NEXT_PUBLIC_SEARCH_API_URL=/api/search
ARG NEXT_PUBLIC_SCHEDULING_API_URL=/api/scheduling
ARG NEXT_PUBLIC_VOICE_API_URL=/api/voice
ARG AUTH_SERVICE_ORIGIN=http://auth:3001
ARG TEACHER_SERVICE_ORIGIN=http://teacher:3002
ARG SEARCH_SERVICE_ORIGIN=http://search:3003
ARG SCHEDULING_SERVICE_ORIGIN=http://scheduling:3004
ARG VOICE_SERVICE_ORIGIN=http://voice:3005
ENV NEXT_PUBLIC_AUTH_API_URL=$NEXT_PUBLIC_AUTH_API_URL
ENV NEXT_PUBLIC_TEACHER_API_URL=$NEXT_PUBLIC_TEACHER_API_URL
ENV NEXT_PUBLIC_SEARCH_API_URL=$NEXT_PUBLIC_SEARCH_API_URL
ENV NEXT_PUBLIC_SCHEDULING_API_URL=$NEXT_PUBLIC_SCHEDULING_API_URL
ENV NEXT_PUBLIC_VOICE_API_URL=$NEXT_PUBLIC_VOICE_API_URL
ENV AUTH_SERVICE_ORIGIN=$AUTH_SERVICE_ORIGIN
ENV TEACHER_SERVICE_ORIGIN=$TEACHER_SERVICE_ORIGIN
ENV SEARCH_SERVICE_ORIGIN=$SEARCH_SERVICE_ORIGIN
ENV SCHEDULING_SERVICE_ORIGIN=$SCHEDULING_SERVICE_ORIGIN
ENV VOICE_SERVICE_ORIGIN=$VOICE_SERVICE_ORIGIN
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter "@learn-and-build/web..." run build

FROM base AS runtime
ENV NODE_ENV=production
ENV PORT=3100
WORKDIR /repo
COPY --from=build /repo /repo
WORKDIR /repo/apps/web
EXPOSE 3100
CMD ["pnpm", "start"]
